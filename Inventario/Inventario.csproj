  <!-- Solo se publica el idioma espanol de ReportViewer (los otros 9 idiomas pesaban 25 MB en cada actualizacion). -->
  <Target Name="QuitarIdiomasReportViewer" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceSatellitePaths Remove="@(ReferenceSatellitePaths)" Condition="'%(ReferenceSatellitePaths.DestinationSubDirectory)' != 'es\'" />
      <!-- Tambien hay que quitarlos de las copias locales: si no, ClickOnce los publica como ensamblados normales
           en la raiz (todos con el mismo nombre) y una instalacion limpia truena con "La referencia del manifiesto
           no coincide con la identidad del ensamblado descargado ...resources.dll" -->
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="$([System.String]::Copy('%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)').EndsWith('.resources.dll')) And '%(ReferenceCopyLocalPaths.DestinationSubDirectory)' != '' And '%(ReferenceCopyLocalPaths.DestinationSubDirectory)' != 'es\'" />
    </ItemGroup>
  </Target>
